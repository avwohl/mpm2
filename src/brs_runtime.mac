; The compiler's own BDOS entry for the banked half of a resident system
; process (.BRS)
;
; DRI linked every *BRS.PLM as
;
;       link xxbrs.obj,brspbi,plm80.lib to xxbrs.mod
;
; and so does the build: UTIL2/BRSPBI.ASM, "Banked Resident System Process
; BDOS Interface", unmodified.  A BRS runs in bank 0 and has no page zero of
; its own to find the BDOS through.  It reaches it through OS, the word at
; offset 0 of the .BRS: GENSYS stores the base of the process's .RSP there,
; and when MP/M creates the process at boot it stores its BDOS entry in the
; first word of that .RSP.  BRSPBI's MON1/MON2/MON2A are that double
; indirection, taking the function in C and the parameter in DE, which is how
; uplm80 passes them.
;
; uplm80 in MP/M mode open-codes a MON1 or MON2 call whose function number is a
; constant as `ld de,info / ld c,func / call ??BDOS', so ??BDOS is the same
; code as BRSPBI's rather than the 0005H of mpm_pagezero.mac.
;
; ??BOOT is where uplm80's program entry goes if the procedure it called ever
; returns.  A BRS process never does, but if it did, BDOS function 0 in a
; process terminates it, which is what a return to the operating system means
; here; there is no warm-boot vector in bank 0 to jump to.

        .z80

        extrn   OS              ; offset 0 of the .BRS, the .RSP's base

        cseg

??BDOS:                         ; C = function, DE = parameter
        public  ??BDOS
        ld      hl,(OS)         ; HL = base of the .RSP
        ld      a,(hl)          ; whose first word MP/M set to its BDOS entry
        inc     hl
        ld      h,(hl)
        ld      l,a
        jp      (hl)

??BOOT:
        public  ??BOOT
        ld      c,0             ; terminate process
        jp      ??BDOS

        end
