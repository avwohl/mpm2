; Runtime for the banked half of a resident system process (.BRS)
;
; This is DRI's UTIL2/BRSPBI.ASM, "Banked Resident System Process BDOS
; Interface", for uplm80's calling conventions.  DRI linked every *BRS.PLM as
;
;       link xxbrs.obj,brspbi,plm80.lib to xxbrs.mod
;
; A BRS runs in bank 0 and has no page zero of its own to find the BDOS
; through.  It reaches it through OS, the word at offset 0 of the .BRS: GENSYS
; stores the base of the process's .RSP there, and when MP/M creates the
; process at boot it stores its BDOS entry in the first word of that .RSP.
; BRSPBI's MON1/MON2/MON2A are the double indirection
;
;       lhld os / mov a,m / inx h / mov h,m / mov l,a / pchl
;
; taking the function in C and the parameter in DE, as PL/M-80 passed them.
;
; uplm80 in MP/M mode open-codes a MON1 or MON2 call whose function number is a
; constant as `ld de,info / ld c,func / call ??BDOS', which is exactly that
; register interface, so here ??BDOS is BRSPBI's code rather than the 0005H of
; mpm_pagezero.mac.  A call the compiler cannot open-code - MON2A, or a
; function number that is not a constant - pushes its arguments, left to right
; and widened to 16 bits, and calls MON1/MON2/MON2A; those pick them up the way
; mpm_runtime.mac does and fall into ??BDOS.
;
; ??BOOT is where uplm80's program entry goes if the procedure it called ever
; returns.  A BRS process never does, but if it did, BDOS function 0 in a
; process terminates it, which is what a return to the operating system means
; here; there is no warm-boot vector in bank 0 to jump to.

        .z80

        extrn   OS              ; offset 0 of the .BRS, the .RSP's base

        cseg

MON1:                           ; void return
        public  MON1
MON2:                           ; BYTE return, in A
        public  MON2
MON2A:                          ; ADDRESS return, in HL
        public  MON2A
        ld      hl,2            ; skip the return address
        add     hl,sp
        ld      e,(hl)          ; info, low
        inc     hl
        ld      d,(hl)          ; info, high
        inc     hl
        ld      c,(hl)          ; func (a BYTE widened to 16 bits)
                                ; fall into ??BDOS: it returns to our caller

??BDOS:                         ; C = function, DE = parameter
        public  ??BDOS
        ld      hl,(OS)         ; HL = base of the .RSP
        ld      a,(hl)          ; whose first word MP/M set to its BDOS entry
        inc     hl
        ld      h,(hl)
        ld      l,a
        jp      (hl)

??BOOT:
        public  ??BOOT
        ld      c,0             ; terminate process
        jp      ??BDOS

        end
