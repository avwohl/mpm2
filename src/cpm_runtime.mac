; CP/M Runtime Definitions for uplm80
; Standard CP/M and MP/M addresses as absolute equates

        .z80

; CP/M Page Zero addresses
BOOT    equ     0000H           ; Cold boot entry
IOBYTE  equ     0003H           ; I/O byte
CDISK   equ     0004H           ; Current disk
BDISK   equ     0004H           ; Current disk (alternate name)
BDOS    equ     0005H           ; BDOS entry point
MAXB    equ     0006H           ; Top of memory address (in BDOS jump)
WBOOT   equ     0038H           ; Warm boot entry
FCB     equ     005CH           ; Default FCB (36 bytes)
FCB16   equ     006CH           ; Second FCB
BUFF    equ     0080H           ; DMA buffer (alternate name)
TBUFF   equ     0080H           ; Default DMA buffer (128 bytes)
TPA     equ     0100H           ; Transient Program Area start

; The command drive and the two password fields MP/M's CLI fills in for a
; transient: 0050H the drive the command came from, 0051H/0053H the address
; and length of the first file's password, 0054H/0056H the second's.  These
; are DRI's own values, from PLM_WORK/X0100.ASM.  MP/M II's CLI zeroes
; 0051H-0056H (NUCLEUS/CLI.ASM, "tptpw"/"tnpw"), so ED, TYPE and ERAQ -
; which test `len0 <> 0' - never take their password path.  With LEN0 at
; 0080H, the command tail's length, they took it whenever a file was named.
CMDRV   equ     0050H           ; Command drive
PASS0   equ     0051H           ; First password's address
LEN0    equ     0053H           ; First password's length
PASS1   equ     0054H           ; Second password's address
LEN1    equ     0056H           ; Second password's length

; ============================================================
; PL/M-80 Runtime Library Functions
;
; Called by uplm80-generated code as external PROCEDUREs, so the
; arguments arrive on the stack - pushed left to right, each widened to
; 16 bits, popped by the caller:
;
;       ld  hl,func  / push hl
;       ld  hl,info  / push hl
;       call mon3
;       pop de / pop de
;
; On entry the stack holds the return address, then info, then func.
; (DRI's PL/M-80 passed these in C and DE instead, which is why its
; X0100.ASM could define all of them as EQU 0005H.)  uplm80 open-codes
; MON1 and MON2 when the function number is a constant and calls these
; only when it cannot, which is exactly when the arguments are on the
; stack.
;
; All four are the same code: the BDOS returns a byte in A and an
; address in HL, and uplm80 reads a BYTE result from A and an ADDRESS
; result from HL.
; ============================================================

        cseg

MON1:                           ; void return
        public  MON1
MON2:                           ; BYTE return, in A
        public  MON2
MON2A:                          ; ADDRESS return, in HL
        public  MON2A
MON3:                           ; ADDRESS return, in HL
        public  MON3
        ld      hl,2            ; skip the return address
        add     hl,sp
        ld      e,(hl)          ; info, low
        inc     hl
        ld      d,(hl)          ; info, high
        inc     hl
        ld      c,(hl)          ; func (a BYTE widened to 16 bits)
        jp      BDOS            ; tail call: the BDOS returns to our caller

; Export page zero symbols
; The compiler's own page-zero references.  uplm80 emits these names, with its
; reserved `??' prefix, for the BDOS entry, the stack top and the warm-boot
; jump, so that a program declaring its own `bdos' or `boot' cannot capture
; them - UTIL7/DM.PLM declares a variable called `bdos'.
??BDOS  equ     0005H
??BOOT  equ     0000H
??MAXB  equ     0006H
        public  ??BDOS, ??BOOT, ??MAXB

        public  BOOT, WBOOT, BDOS
        public  IOBYTE, CDISK, BDISK, CMDRV
        public  MAXB, BUFF
        public  FCB, FCB16, TBUFF, TPA
        public  PASS0, LEN0, PASS1, LEN1

        end
