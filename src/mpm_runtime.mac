; PL/M-80 runtime library for MP/M relocatable programs
;
; The BDOS entry is reached through an external symbol (see mpm_pagezero.mac)
; so the linker records the reference in the .PRL relocation bitmap.
; Assembling `call 5' here instead would call absolute address 0005H, which
; under MP/M is the system's page zero rather than the process's.
;
; MON1/MON2/MON2A/MON3 take their arguments the way uplm80 passes them to an
; external PROCEDURE - pushed left to right, each widened to 16 bits, and
; popped by the caller:
;
;       ld  hl,func  / push hl
;       ld  hl,info  / push hl
;       call mon3
;       pop de / pop de
;
; so on entry the stack holds the return address, then info, then func.  This
; is not DRI's convention: PL/M-80 passed these in C and DE, which is why
; X0100.ASM could define all three as EQU 0005H.  uplm80 open-codes MON1 and
; MON2 when the function number is a constant, and reaches these routines only
; when it cannot, which is exactly when the arguments are on the stack.
;
; All four are the same code.  The BDOS returns a byte in A and an address in
; HL, and uplm80 reads a BYTE result from A and an ADDRESS result from HL, so
; one shim serves every return type.

        .z80

        extrn   BDOS

        cseg

; MON1 - BDOS call, no return value (void procedure)
MON1:
        public  MON1
; MON2 - BDOS call, returns BYTE in A
MON2:
        public  MON2
; MON2A - BDOS call, returns ADDRESS in HL
MON2A:
        public  MON2A
; MON3 - BDOS call, returns ADDRESS in HL
MON3:
        public  MON3
        ld      hl,2            ; skip the return address
        add     hl,sp
        ld      e,(hl)          ; info, low
        inc     hl
        ld      d,(hl)          ; info, high
        inc     hl
        ld      c,(hl)          ; func (a BYTE widened to 16 bits)
        jp      BDOS            ; tail call: the BDOS returns to our caller

        end
