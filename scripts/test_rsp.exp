#!/usr/bin/expect -f
#
# test_rsp.exp - check DRI's resident system processes over SSH
# Part of MP/M II Emulator
# SPDX-License-Identifier: GPL-3.0-or-later
#
# Usage: ./test_rsp.exp [port]
#
# A generated system carries DRI's four resident system processes, ABORT,
# MPMSTAT, SCHED and SPOOL (scripts/gensys.sh).  Each check below needs the
# resident process itself, not the transient of the same name: with the RSP
# missing, SCHED.PRL answers "Resident portion of scheduler is not in
# memory", ABORT.PRL does the abort itself, and "spoolq" is not a command.
#
#   mpmstat             the RSP's status display lists the RSPs' queues
#   sched               SCHED.PRL finds the resident scheduler...
#   sched <today> 00:00 ...which runs a command whose time has come
#   abort nosuch        "Msg Qued", then the ABORT RSP's own "Abort failed."
#   spoolq file[d]      the spooler RSP prints the file and deletes it;
#                       with a STOPSPLR message waiting it stops at the first
#                       line and the file stays (checked once the spooler
#                       has deleted a second file queued behind it)
#
# SPOOLQ is the spooler's queue: typing a queue's name at the CLI sends the
# rest of the line to it ("Msg Qued"), which is what SPOOL.PRL does after it
# has checked the files.  Going straight to the queue tests the spooler RSP
# the same way under V2.0 and V2.1 - V2.0's SPOOL.PRL rejects the [D] option.
# There is no printer: the emulator's XIOS LIST discards what it is given, so
# the evidence that the spooler read the file to the end is that it deleted it.
# The spooler runs at a low priority: a deletion is waited for by asking DIR
# every half second for up to 10 seconds, not by looking once after a fixed
# pause, which a slow machine could fail - or pass without the spooler having
# run at all.

set timeout 30
set port [lindex $argv 0]
if {$port eq ""} {
    set port 2222
}
match_max 20000
log_user 1

set prompt {\d+[A-P]>}
set failures 0

proc fail {msg} {
    global failures
    puts "\n>>> FAIL: $msg"
    incr failures
}

proc pass {msg} {
    puts "\n>>> ok: $msg"
}

# Send a command after letting the console settle (see test_ssh.exp)
proc cmd {c} {
    after 300
    send -- "$c\r"
}

proc wait_prompt {what} {
    global prompt
    expect {
        -re $prompt {}
        timeout { fail "no prompt after $what" }
        eof { fail "connection closed after $what"; exit 1 }
    }
}

puts "=== MP/M II resident system process test ==="
spawn ssh -tt -p $port -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null user@localhost
expect {
    -re $prompt {}
    timeout { puts "\n>>> TIMEOUT waiting for prompt"; exit 1 }
    eof { puts "\n>>> Connection closed unexpectedly"; exit 1 }
}

# --- MPMSTAT: the display comes from the RSP, after CLI's "Msg Qued"
cmd "mpmstat"
expect {
    -re {Status Display(.*)Memory Allocation:} {
        set display $expect_out(1,string)
        if {[regexp {Queue\(s\):(.*?)Process\(es\) Attached} $display -> queues]} {
            foreach q {ABORT MPMSTAT Sched SPOOLQ STOPSPLR} {
                if {[regexp "\\m$q\\M" $queues]} {
                    pass "mpmstat lists queue $q"
                } else {
                    fail "mpmstat does not list queue $q"
                }
            }
        } else {
            fail "mpmstat display has no queue list"
        }
    }
    -re {Msg Qued} { exp_continue }
    timeout { fail "mpmstat printed no status display" }
}
wait_prompt "mpmstat"

# --- SCHED: the transient finds the resident scheduler
cmd "sched"
expect {
    -re {Resident portion of scheduler is not in memory} {
        fail "sched: resident portion of scheduler is not in memory"
    }
    -re {Illegal time/date specification} { pass "sched finds the resident scheduler" }
    timeout { fail "sched: no answer" }
}
wait_prompt "sched"

# ...and the scheduler runs a command that is already due
set today ""
cmd "tod"
expect {
    -re {(\d\d/\d\d/\d\d) \d\d:\d\d:\d\d} { set today $expect_out(1,string) }
    timeout { fail "tod: no date" }
}
wait_prompt "tod"
if {$today ne ""} {
    cmd "sched $today 00:00 user"
    expect {
        -re {User Number = } { pass "sched ran a scheduled command" }
        -re {Resident portion} { fail "sched: resident portion not in memory" }
        timeout { fail "sched: the scheduled command did not run" }
    }
    wait_prompt "scheduled command"
}

# --- ABORT: the RSP's own message.  ABORT.PRL prints the same words, so
# the CLI must have queued the line ("Msg Qued") before it counts: loaded
# as a program, ABORT.PRL says "Abort failed." with no queue involved.
cmd "abort nosuch"
expect {
    -re {Msg Qued} {
        expect {
            -re {Abort failed\.} { pass "abort reaches the ABORT RSP" }
            -re $prompt { fail "abort: queued, but the ABORT RSP did not answer" }
            timeout { fail "abort: queued, but no answer from the ABORT RSP" }
        }
    }
    -re {\.PRL} { fail "abort: no ABORT queue, the CLI loaded a program" }
    -re {Abort failed\.} { fail "abort: \"Abort failed.\" without \"Msg Qued\" - not the RSP" }
    timeout { fail "abort: no answer" }
}
wait_prompt "abort"

# --- SPOOL and STOPSPLR
# Send a line to a queue; true if the CLI queued it
proc queue_msg {c} {
    cmd $c
    set queued 0
    expect {
        -re {Msg Qued} { set queued 1 }
        -re {\.PRL} { fail "$c: no queue, the CLI loaded a program" }
        timeout { fail "$c: no answer" }
    }
    wait_prompt $c
    return $queued
}

# 1 if the file is there, 0 if not, -1 if dir did not answer
proc file_present {name} {
    cmd "dir $name"
    expect {
        -re {File not found} { set present 0 }
        -re "[string toupper [lindex [split $name .] 0]] +[string toupper [lindex [split $name .] 1]]" {
            set present 1
        }
        timeout { set present -1 }
    }
    wait_prompt "dir $name"
    return $present
}

# Wait up to 10 seconds for the spooler to delete a file.  It runs at a low
# priority, so it is asked again every half second rather than once after a
# fixed wait: a slow machine must neither fail this nor pass it untested.
# 1 once the file is gone, 0 if it is still there, -1 if dir stops answering
proc spooler_deletes {name} {
    set deadline [expr {[clock milliseconds] + 10000}]
    while 1 {
        set present [file_present $name]
        if {$present != 1} {
            return [expr {$present == 0 ? 1 : -1}]
        }
        if {[clock milliseconds] >= $deadline} {
            return 0
        }
        after 500
    }
}

cmd "era spltest.txt"
wait_prompt "era"
cmd "era splmark.txt"
wait_prompt "era"
cmd "pip spltest.txt=dump.asm\[g0\]"
wait_prompt "pip"
cmd "pip splmark.txt=dump.asm\[g0\]"
wait_prompt "pip"

# A stop request waiting in STOPSPLR stops the next listing at its first
# line, and the file stays.  That the file is still there means something
# only once the spooler has finished with it, so a second file goes into
# the queue behind it: the spooler takes one request at a time, in order,
# and when it has listed and deleted splmark.txt it is done with spltest.txt.
if {[queue_msg "stopsplr"] && [queue_msg "spoolq spltest.txt\[d\]"] &&
    [queue_msg "spoolq splmark.txt\[d\]"]} {
    switch -- [spooler_deletes splmark.txt] {
        1 {
            switch -- [file_present spltest.txt] {
                1 { pass "stopsplr stopped the spooler before the end of the file" }
                0 { fail "stopsplr did not stop the spooler: it deleted the file" }
                default { fail "dir spltest.txt: no answer" }
            }
        }
        0 { fail "the spooler did not get to the second file in 10 seconds" }
        default { fail "dir splmark.txt: no answer" }
    }
}

# Without one, the spooler prints the whole file and then deletes it
if {[queue_msg "spoolq spltest.txt\[d\]"]} {
    switch -- [spooler_deletes spltest.txt] {
        1 { pass "the spooler listed the file and deleted it" }
        0 { fail "the spooler did not finish the file in 10 seconds: it is still there" }
        default { fail "dir spltest.txt: no answer" }
    }
}
cmd "era spltest.txt"
wait_prompt "era"
cmd "era splmark.txt"
wait_prompt "era"

send "\r"
after 500
close
wait

if {$failures > 0} {
    puts "\n>>> $failures RSP check(s) failed"
    exit 1
}
puts "\n>>> All RSP checks passed"
exit 0
